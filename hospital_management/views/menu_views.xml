<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu shown in the main apps switcher -->
    <menuitem id="menu_hospital_root"
              name="Hospital"
              sequence="10"/>

    <!-- First level -->
    <menuitem id="menu_hospital_appointments"
              name="Appointments"
              parent="menu_hospital_root"
              action="action_hospital_appointment"
              sequence="10"/>

    <menuitem id="menu_hospital_patients"
              name="Patients"
              parent="menu_hospital_root"
              action="action_hospital_patient"
              sequence="20"/>

    <menuitem id="menu_hospital_doctors"
              name="Doctors"
              parent="menu_hospital_root"
              action="action_hospital_doctor"
              sequence="30"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_hospital_configuration"
              name="Configuration"
              parent="menu_hospital_root"
              sequence="100"/>

    <menuitem id="menu_hospital_departments"
              name="Departments"
              parent="menu_hospital_configuration"
              action="action_hospital_department"
              sequence="10"/>
</odoo>
