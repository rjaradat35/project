<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_hospital_department_list" model="ir.ui.view">
        <field name="name">hospital.department.list</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_hospital_department_form" model="ir.ui.view">
        <field name="name">hospital.department.form</field>
        <field name="model">hospital.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Cardiology"/>
                        <field name="code" placeholder="e.g. CARD"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Doctors" name="doctors">
                            <field name="doctor_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="specialization"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Challenge: chatter on every form view -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hospital.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
