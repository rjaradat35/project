<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="appointment_count"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Dr. John Smith"/>
                        </h1>
                        <field name="reference" readonly="1"/>
                    </div>
                    <group>
                        <group string="Professional Information">
                            <field name="specialization"/>
                            <field name="department_id"/>
                            <field name="years_of_experience"/>
                            <field name="consultation_fee"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Personal Information">
                            <field name="gender"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments" name="appointments">
                            <field name="appointment_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="patient_id"/>
                                    <field name="appointment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Challenge: chatter on every form view -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban view: nice cards with the doctor's photo -->
    <record id="view_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hospital.doctor.kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="image" widget="image" class="o_kanban_image me-2"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div><field name="specialization"/></div>
                                <div class="text-muted"><field name="department_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="specialization"/>
                <field name="department_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Specialization" name="group_specialization"
                            context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first doctor
            </p>
        </field>
    </record>
</odoo>
